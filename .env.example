# ==============================================
# EduNode Analytics - Environment Configuration
# ==============================================
# Copy this file to .env.local and fill in your values

# ==============================================
# AUTHENTICATION (Required)
# ==============================================

# Clerk Authentication (Multi-tenant SSO)
# Get these from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/select-school
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ==============================================
# DATABASE (Required)
# ==============================================

# Supabase (Metadata & User Settings)
# Get these from: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx

# ==============================================
# DATA WAREHOUSE (Optional - for BigQuery)
# ==============================================

# Google BigQuery (Analytical Warehouse)
GOOGLE_CLOUD_PROJECT_ID=edunode-analytics
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
BIGQUERY_DATASET_PREFIX=edunode_

# ==============================================
# SIS INTEGRATIONS (Optional)
# ==============================================

# Clever Integration (Roster Sync)
CLEVER_CLIENT_ID=xxxx
CLEVER_CLIENT_SECRET=xxxx

# ClassLink Integration (Roster Sync)
CLASSLINK_CLIENT_ID=xxxx
CLASSLINK_CLIENT_SECRET=xxxx

# ==============================================
# APPLICATION SETTINGS
# ==============================================

# Public URL (for OAuth callbacks, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development

# ==============================================
# PRIVACY & DATA PROTECTION
# ==============================================

# Secret key for consistent data anonymization (Required for AI features)
# Generate with: openssl rand -hex 32
ANONYMIZATION_SECRET=your-secure-random-string

# AI Provider API Keys (Optional - enables live AI features)
# Without these, AI features use local mock implementations
# ANTHROPIC_API_KEY=sk-ant-xxxx
# OPENAI_API_KEY=sk-xxxx
# GOOGLE_AI_API_KEY=xxxx

# ==============================================
# SECURITY & CORS (T1 Security)
# ==============================================

# Comma-separated list of allowed origins for CORS
# In development, localhost:3000 is allowed by default
# In production, add your Vercel domain(s)
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ==============================================
# PAYMENTS (Required)
# ==============================================

# Stripe API Keys
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# ==============================================
# PRODUCTION ONLY
# ==============================================

# Cron job authentication (Vercel sets this automatically)
# CRON_SECRET=your-secure-random-string

# Redis cache URL (optional, for session caching)
# REDIS_URL=redis://localhost:6379

# ==============================================
# MONITORING (T2 Observability)
# ==============================================

# Sentry error tracking (Required for production)
# Get DSN from: https://sentry.io/settings/[org]/projects/[project]/keys/
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# Sentry source map upload (for CI/CD only)
# SENTRY_AUTH_TOKEN=sntrys_xxxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=edunode-analytics

# Analytics (optional)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
